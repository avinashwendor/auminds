# ==========================================
# Railway Environment Variables Configuration
# ==========================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_change_me_in_production_32chars

# 2. Railway PostgreSQL Database
# Auto-populated by Railway when linking PostgreSQL service using ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@host.railway.internal:5432/railway
DATABASE_POOL_MAX=5
DATABASE_SSL=false

# 3. Railway S3-compatible Blob Store (MinIO / S3)
# Auto-populated or manually set from Railway S3/MinIO Plugin
S3_ENDPOINT=https://s3.railway.app
S3_BUCKET=auminds-blob-store
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=us-east-1
S3_PUBLIC_URL=https://s3.railway.app/auminds-blob-store
